<%- include("includes/header", { pageTitle: "Kitoblar | MyLibrary", extraCss: "products", member }) %>

<section class="products-page">
  <h1>Kitoblar katalogi</h1>

  <form id="searchForm" class="search-bar">
    <input type="text" name="search" id="searchInput" placeholder="Kitob nomi yoki muallif bo'yicha qidirish..." value="<%= search %>" />
    <select name="collection" id="collectionSelect">
      <option value="">Barcha kategoriyalar</option>
      <option value="FICTION" <%= collection === "FICTION" ? "selected" : "" %>>Badiiy</option>
      <option value="SCIENCE" <%= collection === "SCIENCE" ? "selected" : "" %>>Ilmiy</option>
      <option value="HISTORY" <%= collection === "HISTORY" ? "selected" : "" %>>Tarix</option>
      <option value="BUSINESS" <%= collection === "BUSINESS" ? "selected" : "" %>>Biznes</option>
      <option value="CHILDREN" <%= collection === "CHILDREN" ? "selected" : "" %>>Bolalar</option>
      <option value="OTHER" <%= collection === "OTHER" ? "selected" : "" %>>Boshqa</option>
    </select>
    <button type="submit" class="btn btn-primary">Qidirish</button>
  </form>

  <% if (member && member.memberType === "ADMIN") { %>
  <section class="admin-panel">
    <h2>📖 Yangi kitob qo'shish (Admin)</h2>
    <form id="createProductForm" class="admin-form" enctype="multipart/form-data">
      <input type="text" name="productName" placeholder="Kitob nomi" required />
      <input type="text" name="productAuthor" placeholder="Muallif" required />
      <select name="productCollection" required>
        <option value="FICTION">Badiiy</option>
        <option value="SCIENCE">Ilmiy</option>
        <option value="HISTORY">Tarix</option>
        <option value="BUSINESS">Biznes</option>
        <option value="CHILDREN">Bolalar</option>
        <option value="OTHER">Boshqa</option>
      </select>
      <input type="number" name="productPrice" placeholder="Narxi" required min="0" />
      <input type="number" name="productStock" placeholder="Nusxalar soni" required min="1" />
      <textarea name="productDesc" placeholder="Tavsif"></textarea>
      <input type="file" name="productImage" accept="image/*" />
      <button type="submit" class="btn btn-primary">Qo'shish</button>
    </form>
  </section>
  <% } %>

  <div id="bookGrid" class="book-grid">
    <% products.forEach(function(p) { %>
      <div class="book-card" data-id="<%= p._id %>" data-status="<%= p.productStatus %>">
        <img src="<%= p.productImage %>" alt="<%= p.productName %>" />
        <h3><%= p.productName %></h3>
        <p class="author"><%= p.productAuthor %></p>
        <p class="collection"><%= p.productCollection %></p>
        <p class="price"><%= p.productPrice %> so'm</p>
        <p class="stock">Mavjud nusxalar: <%= p.productStock %></p>

        <% if (member && member.memberType === "USER") { %>
          <button class="btn btn-primary rent-btn" data-id="<%= p._id %>" <%= p.productStock < 1 ? "disabled" : "" %>>
            <%= p.productStock < 1 ? "Mavjud emas" : "Ijaraga olish" %>
          </button>
        <% } %>

        <% if (member && member.memberType === "ADMIN") { %>
          <div class="admin-actions">
            <button class="btn btn-small status-btn" data-id="<%= p._id %>" data-status="PROCESS">Faollashtirish</button>
            <button class="btn btn-small status-btn" data-id="<%= p._id %>" data-status="PAUSE">To'xtatish</button>
            <button class="btn btn-small btn-danger delete-btn" data-id="<%= p._id %>">O'chirish</button>
          </div>
        <% } %>
      </div>
    <% }); %>
    <% if (products.length === 0) { %>
      <p>Hech qanday kitob topilmadi.</p>
    <% } %>
  </div>
</section>

</main>
<script src="/js/main.js"></script>
<script src="/js/products.js"></script>
</body>
</html>
