<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== "undefined" ? pageTitle : "Kutubxona Tizimi" %></title>
  <link rel="stylesheet" href="/css/main.css" />
  <% if (typeof extraCss !== "undefined") { %>
    <link rel="stylesheet" href="/css/<%= extraCss %>.css" />
  <% } %>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>
<body>
  <header class="app-header">
    <div class="header-inner">
      <a href="/" class="logo">📚 MyLibrary</a>
      <nav class="main-nav">
        <a href="/">Bosh sahifa</a>
        <a href="/products">Kitoblar</a>
        <% if (member) { %>
          <a href="/orders">Mening ijaralarim</a>
          <% if (member.memberType === "ADMIN") { %>
            <span class="admin-badge">ADMIN</span>
          <% } %>
          <span class="member-name"><%= member.memberFullName || member.memberNick %></span>
          <a href="#" id="logoutBtn">Chiqish</a>
        <% } else { %>
          <a href="/login">Kirish</a>
          <a href="/signup">Ro'yxatdan o'tish</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="app-main">
