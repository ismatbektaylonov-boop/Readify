<%- include("includes/header", { pageTitle: "Kirish | MyLibrary" , extraCss: "login" }) %>

  <main class="login-container">
    <div class="auth-nova" data-auth-nova aria-hidden="true"></div>

    <div class="login-frame">
      <div class="login-top">
        <a href="/" class="brand">
          <span class="brand-mark">M</span>
          MyLibrary
        </a>
        <p class="eyebrow">A'ZO KIRISHI</p>
        <h1>Xush kelibsiz, o'quvchi.</h1>
        <p class="intro">Javonlaringizga va ijara tarixingizga kirish uchun tizimga kiring.</p>
      </div>

      <div id="formError" class="form-error" style="display:none;"></div>

      <form id="loginForm" class="login-input-frame">
        <div class="login-input-container">
          <label for="memberNick">Login</label>
          <input type="text" id="memberNick" name="memberNick" required placeholder="Login kiriting" />
        </div>
        <div class="login-input-container">
          <label for="memberPassword">Parol</label>
          <input type="password" id="memberPassword" name="memberPassword" required placeholder="Parol kiriting" />
        </div>
        <button type="submit" class="login-btn">Kirish</button>
      </form>

      <p class="login-footer">Akkountingiz yo'qmi? <a href="/signup">Ro'yxatdan o'ting</a></p>
    </div>
  </main>

  <script src="/js/main.js"></script>
  <script src="/js/auth-nova.js"></script>
  </body>

  </html>